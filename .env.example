# Copy to `.env` for local dev:  cp .env.example .env
# Restart Vite after edits:     npm run dev
#
# --- Two Vercel projects (matches server/vercel.json API-only deploy) ---
# 1. Server project — Root Directory: `server` → API at https://<server>.vercel.app/api
# 2. Client project — Root Directory: `client` → SPA (this app)
#
# Set these in the CLIENT Vercel project → Environment Variables, then redeploy:
#   VITE_API_BASE_URL = https://<server-project>.vercel.app/api
#   VITE_SITE_URL     = https://<client-project>.vercel.app
#
# On the SERVER project, set CLIENT_ORIGIN to your client URL (comma-separated if several).

# Local API (server on PORT from server/.env, default 5050)
VITE_API_BASE_URL=http://localhost:5050/api
VITE_SITE_URL=http://localhost:3000

# Production (Vercel client project → Environment Variables)
# VITE_API_BASE_URL=https://<your-server>.vercel.app/api
# VITE_SITE_URL=https://<your-client>.vercel.app
