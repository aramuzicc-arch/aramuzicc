# --- Public site (shown in meta / optional client-only links) ---
# Production frontend URL (no trailing slash recommended)
# VITE_SITE_URL=https://aramuzicc.vercel.app

# --- API ---
# Must end with /api. Local dev (avoid :5000 on macOS — AirPlay uses it):
# VITE_API_BASE_URL=http://localhost:5050/api
#
# Same Vercel project as this repo (Express via /api serverless — see root vercel.json):
# VITE_API_BASE_URL=https://aramuzicc.vercel.app/api
#
# Or a separate API host (Railway, Render, Fly, etc.):
# VITE_API_BASE_URL=https://your-api.example.com/api

# Optional — used by Login.tsx when configured
# VITE_KIMI_AUTH_URL=
# VITE_APP_ID=
